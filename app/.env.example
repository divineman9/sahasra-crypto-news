DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cryptonews?schema=public"
REDIS_URL="redis://localhost:6379"
WS_PORT=4181
NEXT_PUBLIC_WS_URL="ws://localhost:4181"
INGEST_INTERVAL_MS=5000
# --- Real news ingest (Phase 1) ---
# Discord webhook for news + source-health alerts (empty = alerts off)
DISCORD_NEWS_WEBHOOK=""
# Extra tickers to alert on, comma-separated (the base-break dashboard coins are added automatically)
NEWS_PORTFOLIO=""
# SEC press-release feed: SEC requires a declared User-Agent with a contact email, e.g. "CryptoNewsTerminal/1.0 you@example.com" (empty = SEC feed off)
SEC_USER_AGENT=""
# Where the dashboard news file is written / where the base-break coins are read from
NEWS_LIVE_JSON="D:\claude projects\crypto\screener\news_live.json"
BBW_LIVE_JSON="D:\claude projects\crypto\screener\base_break_live.json"
# --- Reddit Social tab (Phase 3 step 7) — create a free "script" app at https://www.reddit.com/prefs/apps, then fill all four (empty = Reddit adapters off)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
# If the Reddit account has 2FA enabled, either disable it for this script-app account or set
# REDDIT_PASSWORD to "yourpassword:123456" (password:otp) — Reddit's password grant requires this.
# Optional; defaults to "SahasraNews/1.0 (by u/<REDDIT_USERNAME>)"
REDDIT_USER_AGENT=""