# SEC press-release feed: SEC requires a declared User-Agent with a contact email, e.g. "CryptoNewsTerminal/1.0 you@example.com" (empty = SEC feed off)
SEC_USER_AGENT=""
# Where the dashboard news file is written / where the base-break coins are read from
NEWS_LIVE_JSON="D:\claude projects\crypto\screener\news_live.json"
BBW_LIVE_JSON="D:\claude projects\crypto\screener\base_break_live.json"