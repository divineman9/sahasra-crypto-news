@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --neon-bg: #05060d;
  --neon-cyan: #00f0ff;
  --neon-lime: #39ff14;
  --neon-red: #ff3860;
  --neon-amber: #ffb000;
  --neon-magenta: #ff2bd6;
  --neon-violet: #9d4dff;
}

body {
  background-color: var(--neon-bg);
  background-image:
    radial-gradient(ellipse at top, rgba(0, 240, 255, 0.08), transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(255, 43, 214, 0.06), transparent 55%),
    linear-gradient(rgba(0, 240, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 240, 255, 0.035) 1px, transparent 1px);
  background-size: auto, auto, 32px 32px, 32px 32px;
  background-attachment: fixed;
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 240, 255, 0.35) transparent;
}

*::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background-color: rgba(0, 240, 255, 0.35);
  border-radius: 3px;
}

*::-webkit-scrollbar-thumb:hover {
  background-color: rgba(0, 240, 255, 0.6);
}

.text-emerald-400,
.text-emerald-300 {
  text-shadow: 0 0 6px rgba(57, 255, 20, 0.55);
}

.text-rose-400,
.text-rose-300 {
  text-shadow: 0 0 6px rgba(255, 56, 96, 0.6);
}

.text-amber-400,
.text-amber-300 {
  text-shadow: 0 0 6px rgba(255, 176, 0, 0.5);
}

.text-cyan-300,
.text-cyan-400,
.text-sky-300,
.text-sky-400 {
  text-shadow: 0 0 6px rgba(0, 240, 255, 0.55);
}

.text-orange-400 {
  text-shadow: 0 0 6px rgba(255, 43, 214, 0.6);
}

.border-emerald-500,
.border-emerald-500\/50,
.border-emerald-500\/40 {
  box-shadow: 0 0 8px rgba(57, 255, 20, 0.25);
}

.border-rose-500 {
  box-shadow: 0 0 8px rgba(255, 56, 96, 0.35);
}

.border-cyan-500\/30 {
  box-shadow: 0 0 8px rgba(0, 240, 255, 0.2);
}

.bg-slate-900\/95,
.bg-slate-800\/60 {
  backdrop-filter: blur(6px);
}

@keyframes flash {
  0% {
    background-color: rgba(0, 240, 255, 0.18);
    box-shadow: inset 0 0 12px rgba(0, 240, 255, 0.35);
  }
  100% {
    background-color: transparent;
    box-shadow: inset 0 0 12px transparent;
  }
}

.row-flash {
  animation: flash 2s ease-out forwards;
}

a:hover {
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
}

@media (prefers-reduced-motion: reduce) {
  .row-flash {
    animation: none;
  }
}